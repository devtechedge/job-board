# Production (Vercel) uses Neon. Omit locally to use embedded PGLite.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Admin UI at /admin (required in production)
ADMIN_PASSWORD=change-me

# GitHub Action → POST /api/cron/crawl  (Authorization: Bearer)
CRON_SECRET=change-me
APP_URL=https://jobrow.vercel.app

# Public origin used in sitemap / JSON-LD
VITE_SITE_URL=https://jobrow.vercel.app
